        <mxCell id="adminController" value="&lt;b&gt;AdminController&lt;/b&gt;&lt;hr/&gt;+ getPendingEmployers()&lt;br/&gt;+ approveEmployer(id)&lt;br/&gt;+ getPendingJobs()&lt;br/&gt;+ approveJob(id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
