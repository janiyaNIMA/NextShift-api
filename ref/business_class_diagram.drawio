  <diagram name="UniShift - Business Logic Class Diagram" id="unishift-business-class-diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;UniShift / NextShift — Business Logic Class Diagram&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #555555;&quot;&gt;Domain Entities, OOP Inheritance, Strategy Pattern &amp;amp; Service Layer (Excluding Security Boilerplate)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="820" height="60" as="geometry" />
        </mxCell>

        <!-- BaseEntity (Abstract Class) -->
        <mxCell id="baseEntity" value="&lt;b&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;br&gt;BaseEntity&lt;/b&gt;&lt;hr/&gt;- Long id&lt;br/&gt;- Instant createdAt&lt;br/&gt;- Instant updatedAt&lt;hr/&gt;# onCreate() : void&lt;br/&gt;# onUpdate() : void&lt;br/&gt;+ getId() : Long&lt;br/&gt;+ getCreatedAt() : Instant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- User Entity -->
        <mxCell id="userEntity" value="&lt;b&gt;User&lt;/b&gt;&lt;hr/&gt;- String name&lt;br/&gt;- String email&lt;br/&gt;- String passwordHash&lt;br/&gt;- UserRole role&lt;br/&gt;- boolean active&lt;br/&gt;- boolean approved&lt;hr/&gt;+ approve() : void&lt;br/&gt;+ isStudent() : boolean&lt;br/&gt;+ isEmployer() : boolean&lt;br/&gt;+ isAdmin() : boolean&lt;br/&gt;+ canCreateJobs() : boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="220" height="190" as="geometry" />
        </mxCell>

        <!-- Job Entity -->
        <mxCell id="jobEntity" value="&lt;b&gt;Job&lt;/b&gt;&lt;hr/&gt;- User employer&lt;br/&gt;- String title&lt;br/&gt;- String description&lt;br/&gt;- String category&lt;br/&gt;- String location&lt;br/&gt;- BigDecimal payAmount&lt;br/&gt;- String payUnit&lt;br/&gt;- Instant startsAt&lt;br/&gt;- Instant endsAt&lt;br/&gt;- int capacity&lt;br/&gt;- JobStatus status&lt;br/&gt;- Instant publishedAt&lt;hr/&gt;+ publish() : void&lt;br/&gt;+ reject() : void&lt;br/&gt;+ close() : void&lt;br/&gt;+ isEligibleForBooking(Instant) : boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="280" width="240" height="250" as="geometry" />
        </mxCell>

        <!-- Booking Entity -->
        <mxCell id="bookingEntity" value="&lt;b&gt;Booking&lt;/b&gt;&lt;hr/&gt;- Job job&lt;br/&gt;- User student&lt;br/&gt;- BookingStatus status&lt;br/&gt;- Instant createdAt&lt;hr/&gt;+ getJob() : Job&lt;br/&gt;+ getStudent() : User&lt;br/&gt;+ getStatus() : BookingStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="310" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Enums -->
        <mxCell id="userRoleEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;UserRole&lt;/b&gt;&lt;hr/&gt;+ STUDENT&lt;br/&gt;+ EMPLOYER&lt;br/&gt;+ ADMIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="340" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="jobStatusEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;JobStatus&lt;/b&gt;&lt;hr/&gt;+ PENDING&lt;br/&gt;+ PUBLISHED&lt;br/&gt;+ REJECTED&lt;br/&gt;+ CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="520" width="130" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bookingStatusEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;BookingStatus&lt;/b&gt;&lt;hr/&gt;+ CONFIRMED&lt;br/&gt;+ CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1025" y="490" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- Strategy Pattern: JobRecommendationStrategy Interface -->
        <mxCell id="strategyInterface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;JobRecommendationStrategy&lt;/b&gt;&lt;hr/&gt;+ getRecommendedJobs(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Long studentId,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String category,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String location,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Pageable pageable&lt;br&gt;) : Page&amp;lt;Job&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="240" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Strategy Pattern: Concrete Implementation -->
        <mxCell id="strategyImpl" value="&lt;b&gt;AllPublishedJobsStrategy&lt;/b&gt;&lt;hr/&gt;- JobRepository jobRepository&lt;hr/&gt;+ getRecommendedJobs(...) : Page&amp;lt;Job&amp;gt;&lt;br/&gt;&lt;i&gt;[Filters: PUBLISHED status,&lt;br/&gt;active/approved employer,&lt;br/&gt;future start time, remaining capacity]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="420" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Services Layer -->
        <mxCell id="authService" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;hr/&gt;- UserRepository userRepository&lt;hr/&gt;+ register(RegisterRequest) : AuthResponse&lt;br/&gt;+ login(LoginRequest) : AuthResponse&lt;br/&gt;+ getCurrentUser(email) : UserResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="660" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="jobService" value="&lt;b&gt;JobService&lt;/b&gt;&lt;hr/&gt;- JobRepository jobRepository&lt;br/&gt;- JobRecommendationStrategy recommendationStrategy&lt;hr/&gt;+ createJob(employerEmail, req) : JobResponse&lt;br/&gt;+ getPublishedJobs(email, cat, loc, pageable) : Page&lt;br/&gt;+ getJobById(id) : JobResponse&lt;br/&gt;+ getEmployerJobs(employerEmail) : List&lt;JobResponse&gt;&lt;br/&gt;+ getJobOwnedByEmployer(jobId, email) : Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="660" width="350" height="150" as="geometry" />
        </mxCell>

        <mxCell id="bookingService" value="&lt;b&gt;BookingService&lt;/b&gt;&lt;hr/&gt;- BookingRepository bookingRepository&lt;br/&gt;- JobRepository jobRepository&lt;hr/&gt;+ createBooking(jobId, studentEmail) : BookingResponse&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;[Pessimistic write lock + capacity check]&lt;/i&gt;&lt;br/&gt;+ getStudentBookings(studentEmail) : List&lt;br/&gt;+ getBookingsForJob(jobId, employerEmail) : List" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="660" width="310" height="130" as="geometry" />
        </mxCell>

        <mxCell id="adminService" value="&lt;b&gt;AdminService&lt;/b&gt;&lt;hr/&gt;- UserRepository userRepository&lt;br/&gt;- JobRepository jobRepository&lt;hr/&gt;+ getPendingEmployers() : List&amp;lt;UserResponse&amp;gt;&lt;br/&gt;+ approveEmployer(id) : UserResponse&lt;br/&gt;+ getPendingJobs() : List&amp;lt;JobResponse&amp;gt;&lt;br/&gt;+ approveJob(id) : JobResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="660" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- Controllers Layer -->
