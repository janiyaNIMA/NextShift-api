  <diagram name="1. Domain Entities &amp; OOP Hierarchy" id="single-page">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0">
<root>
  <mxCell id="0" />
  <mxCell id="1" parent="0" />

  <!-- Title Banner -->
  <mxCell id="title1" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px; color: #065f46;&quot;&gt;UniShift — Domain Model &amp;amp; OOP Hierarchy&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #047857;&quot;&gt;Entity Relationships, BaseEntity Inheritance, Associations &amp;amp; Rich Domain Methods&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;strokeWidth=2;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="325" y="30" width="1000" height="65" as="geometry" />
  </mxCell>

  <!-- BaseEntity (Abstract Class) -->
  <mxCell id="baseEntity" value="&lt;b&gt;&amp;lt;&amp;lt;abstract, MappedSuperclass&amp;gt;&amp;gt;&lt;br/&gt;BaseEntity&lt;/b&gt;&lt;hr/&gt;- Long id&lt;br/&gt;- Instant createdAt&lt;br/&gt;- Instant updatedAt&lt;hr/&gt;# onCreate() : void&lt;br/&gt;# onUpdate() : void&lt;br/&gt;+ getId() : Long&lt;br/&gt;+ setId(Long) : void&lt;br/&gt;+ getCreatedAt() : Instant&lt;br/&gt;+ getUpdatedAt() : Instant&lt;br/&gt;+ equals(Object) : boolean&lt;br/&gt;+ hashCode() : int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=1;fontColor=#064e3b;" vertex="1" parent="1">
    <mxGeometry x="715" y="130" width="230" height="170" as="geometry" />
  </mxCell>

  <!-- User Entity -->
  <mxCell id="userEntity" value="&lt;b&gt;User&lt;/b&gt;&lt;hr/&gt;- String name&lt;br/&gt;- String email&lt;br/&gt;- String passwordHash&lt;br/&gt;- UserRole role&lt;br/&gt;- boolean active&lt;br/&gt;- boolean approved&lt;hr/&gt;&lt;b&gt;Domain Methods (Encapsulation):&lt;/b&gt;&lt;br/&gt;+ approve() : void&lt;br/&gt;+ isStudent() : boolean&lt;br/&gt;+ isEmployer() : boolean&lt;br/&gt;+ isAdmin() : boolean&lt;br/&gt;+ canCreateJobs() : boolean&lt;br/&gt;+ getName() / setName(...)&lt;br/&gt;+ getEmail() / setEmail(...)&lt;br/&gt;+ getRole() / setRole(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=1;fontColor=#14532d;" vertex="1" parent="1">
    <mxGeometry x="320" y="360" width="260" height="250" as="geometry" />
  </mxCell>

  <!-- Job Entity -->
  <mxCell id="jobEntity" value="&lt;b&gt;Job&lt;/b&gt;&lt;hr/&gt;- User employer&lt;br/&gt;- String title&lt;br/&gt;- String description&lt;br/&gt;- String category&lt;br/&gt;- String location&lt;br/&gt;- BigDecimal payAmount&lt;br/&gt;- String payUnit&lt;br/&gt;- Instant startsAt&lt;br/&gt;- Instant endsAt&lt;br/&gt;- int capacity&lt;br/&gt;- JobStatus status&lt;br/&gt;- Instant publishedAt&lt;hr/&gt;&lt;b&gt;Domain Methods (Encapsulation):&lt;/b&gt;&lt;br/&gt;+ publish() : void&lt;br/&gt;+ reject() : void&lt;br/&gt;+ close() : void&lt;br/&gt;+ isEligibleForBooking(Instant) : boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=1;fontColor=#14532d;" vertex="1" parent="1">
    <mxGeometry x="690" y="360" width="280" height="270" as="geometry" />
  </mxCell>

  <!-- Booking Entity -->
  <mxCell id="bookingEntity" value="&lt;b&gt;Booking&lt;/b&gt;&lt;hr/&gt;- Job job&lt;br/&gt;- User student&lt;br/&gt;- BookingStatus status&lt;hr/&gt;+ getJob() : Job&lt;br/&gt;+ setJob(Job) : void&lt;br/&gt;+ getStudent() : User&lt;br/&gt;+ setStudent(User) : void&lt;br/&gt;+ getStatus() : BookingStatus&lt;br/&gt;+ setStatus(BookingStatus) : void" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=1;fontColor=#14532d;" vertex="1" parent="1">
    <mxGeometry x="1070" y="380" width="240" height="170" as="geometry" />
  </mxCell>

  <!-- Enums -->
  <mxCell id="userRoleEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br/&gt;UserRole&lt;/b&gt;&lt;hr/&gt;+ STUDENT&lt;br/&gt;+ EMPLOYER&lt;br/&gt;+ ADMIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#78350f;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="130" y="420" width="140" height="90" as="geometry" />
  </mxCell>

  <mxCell id="jobStatusEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br/&gt;JobStatus&lt;/b&gt;&lt;hr/&gt;+ PENDING&lt;br/&gt;+ PUBLISHED&lt;br/&gt;+ REJECTED&lt;br/&gt;+ CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#78350f;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="490" y="660" width="140" height="110" as="geometry" />
  </mxCell>

  <mxCell id="bookingStatusEnum" value="&lt;b&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br/&gt;BookingStatus&lt;/b&gt;&lt;hr/&gt;+ CONFIRMED&lt;br/&gt;+ CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#78350f;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1120" y="600" width="140" height="85" as="geometry" />
  </mxCell>

  <!-- Inheritance Arrows (extends BaseEntity) -->
  <mxCell id="inhUser" value="&lt;b&gt;extends&lt;/b&gt;" style="endArrow=block;endFill=0;html=1;rounded=0;strokeWidth=2.5;strokeColor=#059669;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="userEntity" target="baseEntity">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="inhJob" value="&lt;b&gt;extends&lt;/b&gt;" style="endArrow=block;endFill=0;html=1;rounded=0;strokeWidth=2.5;strokeColor=#059669;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobEntity" target="baseEntity">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="inhBooking" value="&lt;b&gt;extends&lt;/b&gt;" style="endArrow=block;endFill=0;html=1;rounded=0;strokeWidth=2.5;strokeColor=#059669;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bookingEntity" target="baseEntity">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <!-- Entity Associations -->
  <mxCell id="relEmployerJob" value="employer [1]" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#334155;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobEntity" target="userEntity">
    <mxGeometry relative="1" as="geometry">
      <mxPoint as="offset" />
    </mxGeometry>
  </mxCell>

  <mxCell id="relJobBooking" value="job [1]" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#334155;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="bookingEntity" target="jobEntity">
    <mxGeometry relative="1" as="geometry">
      <mxPoint as="offset" />
    </mxGeometry>
  </mxCell>

  <mxCell id="relStudentBooking" value="student [1]" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;strokeColor=#334155;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bookingEntity" target="userEntity">
    <mxGeometry relative="1" as="geometry">
      <Array as="points">
        <mxPoint x="1142" y="650" />
        <mxPoint x="502" y="650" />
      </Array>
      <mxPoint as="offset" />
    </mxGeometry>
  </mxCell>

  <!-- Enum Dependencies -->
  <mxCell id="depUserRole" value="" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#d97706;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="userEntity" target="userRoleEnum">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="depJobStatus" value="" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#d97706;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobEntity" target="jobStatusEnum">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="depBookingStatus" value="" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bookingEntity" target="bookingStatusEnum">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <!-- OOP Notes Box -->
  <mxCell id="noteBox1" value="&lt;b&gt;Key OOP Insights Demonstrated Here:&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;Inheritance:&lt;/b&gt; BaseEntity defines shared audit fields (id, createdAt, updatedAt) and lifecycle hooks (@PrePersist). Extended by User, Job, Booking.&lt;br/&gt;• &lt;b&gt;Encapsulation:&lt;/b&gt; All entity fields are strictly private. State changes occur through rich domain methods (job.publish(), user.approve()).&lt;br/&gt;• &lt;b&gt;Composition over Inheritance:&lt;/b&gt; User roles (Student, Employer, Admin) are modeled via UserRole enum composition rather than relational table inheritance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1e3a8a;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="130" y="770" width="760" height="130" as="geometry" />
  </mxCell>

  <!-- Legend -->
  <mxCell id="legend1" value="&lt;b&gt;Diagram Legend / වර්ණ සටහන&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;color: #059669;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Green:&lt;/b&gt; Entities &amp;amp; Base Superclass (Inheritance)&lt;br/&gt;&lt;span style=&quot;color: #d97706;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Yellow:&lt;/b&gt; Enumerations (Type-Safe State &amp;amp; Role)&lt;br/&gt;&lt;span style=&quot;color: #059669;&quot;&gt;▬&lt;/span&gt; &lt;b&gt;Closed Arrow:&lt;/b&gt; Class Inheritance (extends)&lt;br/&gt;&lt;span style=&quot;color: #334155;&quot;&gt;→&lt;/span&gt; &lt;b&gt;Directed Arrow:&lt;/b&gt; Domain Association (1-to-Many)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#334155;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1000" y="770" width="350" height="130" as="geometry" />
  </mxCell>
</root>
