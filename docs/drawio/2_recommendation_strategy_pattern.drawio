  <!-- Title Banner -->
  <mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px; color: #9a3412;&quot;&gt;UniShift — Recommendation Engine (Strategy Pattern &amp;amp; Polymorphism)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #c2410c;&quot;&gt;Subtype Polymorphism, Dependency Inversion (DIP) &amp;amp; Open/Closed Principle (OCP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;strokeWidth=2;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="325" y="30" width="1000" height="65" as="geometry" />
  </mxCell>

  <!-- Client: JobController -->
  <mxCell id="jobController2" value="&lt;b&gt;&amp;lt;&amp;lt;RestController&amp;gt;&amp;gt;&lt;br/&gt;JobController&lt;/b&gt;&lt;hr/&gt;- JobService jobService&lt;hr/&gt;+ getPublishedJobs(&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String category,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String location,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;UserDetails userDetails,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Pageable pageable&lt;br/&gt;) : ResponseEntity&amp;lt;Page&amp;lt;JobResponse&amp;gt;&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#4c1d95;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="120" y="160" width="290" height="150" as="geometry" />
  </mxCell>

  <!-- Service: JobService -->
  <mxCell id="jobService2" value="&lt;b&gt;&amp;lt;&amp;lt;Service&amp;gt;&amp;gt;&lt;br/&gt;JobService&lt;/b&gt;&lt;hr/&gt;- JobRepository jobRepository&lt;br/&gt;- UserRepository userRepository&lt;br/&gt;- BookingRepository bookingRepository&lt;br/&gt;&lt;b style=&quot;color: #ea580c;&quot;&gt;- JobRecommendationStrategy strategy&lt;/b&gt;&lt;hr/&gt;+ getPublishedJobs(...) : Page&amp;lt;JobResponse&amp;gt;&lt;br/&gt;&lt;i&gt;[Calls recommendationStrategy polymorphically]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#0369a1;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="490" y="150" width="360" height="170" as="geometry" />
  </mxCell>

  <!-- Strategy Interface -->
  <mxCell id="strategyInterface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br/&gt;JobRecommendationStrategy&lt;/b&gt;&lt;hr/&gt;+ getRecommendedJobs(&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Long studentId,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String category,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String location,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Pageable pageable&lt;br/&gt;) : Page&amp;lt;Job&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#9a3412;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="960" y="150" width="310" height="150" as="geometry" />
  </mxCell>

  <!-- Concrete Strategy V0 (Active) -->
  <mxCell id="strategyV0" value="&lt;b&gt;&amp;lt;&amp;lt;Component, @Primary&amp;gt;&amp;gt;&lt;br/&gt;AllPublishedJobsStrategy&lt;/b&gt;&lt;hr/&gt;- JobRepository jobRepository&lt;hr/&gt;&lt;b&gt;@Override&lt;/b&gt;&lt;br/&gt;+ getRecommendedJobs(...) : Page&amp;lt;Job&amp;gt;&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Status == PUBLISHED&lt;br/&gt;• Employer active &amp;amp; approved&lt;br/&gt;• startsAt &amp;gt; Instant.now()&lt;br/&gt;• Remaining capacity &amp;gt; confirmed bookings&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#9a3412;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="960" y="380" width="310" height="160" as="geometry" />
  </mxCell>

  <!-- Future Strategy 1 (ML Based) -->
  <mxCell id="strategyFuture1" value="&lt;b&gt;&amp;lt;&amp;lt;future extension&amp;gt;&amp;gt;&lt;br/&gt;MlRecommendationStrategy&lt;/b&gt;&lt;hr/&gt;- MlModelServiceClient mlClient&lt;hr/&gt;&lt;b&gt;@Override&lt;/b&gt;&lt;br/&gt;+ getRecommendedJobs(...) : Page&amp;lt;Job&amp;gt;&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Personalized vector search&lt;br/&gt;• Collaborative skill filtering&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;strokeDasharray=4 4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#475569;" vertex="1" parent="1">
    <mxGeometry x="800" y="600" width="270" height="130" as="geometry" />
  </mxCell>

  <!-- Future Strategy 2 (Proximity Based) -->
  <mxCell id="strategyFuture2" value="&lt;b&gt;&amp;lt;&amp;lt;future extension&amp;gt;&amp;gt;&lt;br/&gt;ProximityRecommendationStrategy&lt;/b&gt;&lt;hr/&gt;- GeolocationService geoService&lt;hr/&gt;&lt;b&gt;@Override&lt;/b&gt;&lt;br/&gt;+ getRecommendedJobs(...) : Page&amp;lt;Job&amp;gt;&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• GPS distance sorting&lt;br/&gt;• Campus walking perimeter&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;strokeDasharray=4 4;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#475569;" vertex="1" parent="1">
    <mxGeometry x="1110" y="600" width="280" height="130" as="geometry" />
  </mxCell>

  <!-- JobRepository -->
  <mxCell id="jobRepo2" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br/&gt;JobRepository&lt;/b&gt;&lt;hr/&gt;+ findEligibleJobs(...) : Page&amp;lt;Job&amp;gt;&lt;br/&gt;+ findByIdWithLock(id) : Optional&amp;lt;Job&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0ea5e9;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#0c4a6e;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1360" y="390" width="240" height="120" as="geometry" />
  </mxCell>

  <!-- Database -->
  <mxCell id="database2" value="&lt;b&gt;MySQL / H2 DB&lt;/b&gt;&lt;br/&gt;Database Storage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#1e293b;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1405" y="580" width="150" height="90" as="geometry" />
  </mxCell>

  <!-- Arrows -->
  <mxCell id="arrCtlSvc" value="calls" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#8b5cf6;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobController2" target="jobService2">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="arrSvcStrat" value="&lt;b&gt;depends on abstraction&lt;br/&gt;&amp;lt;&amp;lt;polymorphic call&amp;gt;&amp;gt;&lt;/b&gt;" style="endArrow=classic;html=1;strokeWidth=2.5;strokeColor=#ea580c;dashed=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobService2" target="strategyInterface">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="arrStratImpl" value="&lt;b&gt;implements&lt;/b&gt;" style="endArrow=block;endFill=0;dashed=1;html=1;strokeWidth=2.5;strokeColor=#ea580c;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="strategyV0" target="strategyInterface">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="arrFuture1" value="implements" style="endArrow=block;endFill=0;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94a3b8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="strategyFuture1" target="strategyInterface">
    <mxGeometry relative="1" as="geometry">
      <Array as="points">
        <mxPoint x="935" y="560" />
        <mxPoint x="1038" y="560" />
      </Array>
    </mxGeometry>
  </mxCell>

  <mxCell id="arrFuture2" value="implements" style="endArrow=block;endFill=0;dashed=1;html=1;strokeWidth=1.5;strokeColor=#94a3b8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="strategyFuture2" target="strategyInterface">
    <mxGeometry relative="1" as="geometry">
      <Array as="points">
        <mxPoint x="1250" y="560" />
        <mxPoint x="1193" y="560" />
      </Array>
    </mxGeometry>
  </mxCell>

  <mxCell id="arrStratRepo" value="executes JPQL" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#0284c7;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="strategyV0" target="jobRepo2">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <mxCell id="arrRepoDb" value="SQL" style="endArrow=classic;html=1;strokeWidth=1.5;strokeColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobRepo2" target="database2">
    <mxGeometry relative="1" as="geometry" />
  </mxCell>

  <!-- Explanation Callout -->
  <mxCell id="callout2" value="&lt;b&gt;Why Strategy Pattern &amp;amp; Polymorphism Matter Here:&lt;/b&gt;&lt;hr/&gt;1. &lt;b&gt;Subtype Polymorphism:&lt;/b&gt; JobService holds a reference to the JobRecommendationStrategy interface. It does not know or care which concrete class executes.&lt;br/&gt;2. &lt;b&gt;Open/Closed Principle (OCP):&lt;/b&gt; New recommendation algorithms (e.g. ML, Proximity) can be added by implementing the interface without modifying a single line of JobService or JobController.&lt;br/&gt;3. &lt;b&gt;Dependency Inversion Principle (DIP):&lt;/b&gt; High-level business logic does not depend on low-level database queries; both depend on the strategy abstraction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1e3a8a;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="120" y="440" width="730" height="150" as="geometry" />
  </mxCell>
</root>
    </mxGraphModel>
  </diagram>
</mxfile>