  <diagram name="4. Exception Hierarchy &amp; Error Handling" id="page-4">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0">
<root>
  <mxCell id="0" />
  <mxCell id="1" parent="0" />

  <!-- Title Banner -->
  <mxCell id="title4" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px; color: #881337;&quot;&gt;UniShift — Custom Exception Hierarchy (Inheritance &amp;amp; Error Shielding)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #be123c;&quot;&gt;Object-Oriented Specialization, Exception Encapsulation &amp;amp; Uniform HTTP Error Translation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;strokeWidth=2;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="325" y="30" width="1000" height="65" as="geometry" />
  </mxCell>

  <!-- RuntimeException -->
  <mxCell id="runtimeEx" value="&lt;b&gt;java.lang.RuntimeException&lt;/b&gt;&lt;hr/&gt;Unchecked base Java exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#1e293b;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="700" y="125" width="250" height="60" as="geometry" />
  </mxCell>

  <!-- ApiException (Superclass) -->
  <mxCell id="apiEx" value="&lt;b&gt;ApiException&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Base Superclass for All Domain Exceptions)&lt;/i&gt;&lt;hr/&gt;- HttpStatus status&lt;hr/&gt;+ ApiException(String message, HttpStatus status)&lt;br/&gt;+ getStatus() : HttpStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="690" y="240" width="270" height="120" as="geometry" />
  </mxCell>

  <!-- Subclasses -->
  <mxCell id="badReqEx" value="&lt;b&gt;BadRequestException&lt;/b&gt;&lt;hr/&gt;HTTP 400 BAD_REQUEST&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Invalid date intervals&lt;br/&gt;• Malformed arguments&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="100" y="440" width="230" height="90" as="geometry" />
  </mxCell>

  <mxCell id="unauthEx" value="&lt;b&gt;UnauthorizedException&lt;/b&gt;&lt;hr/&gt;HTTP 401 UNAUTHORIZED&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Bad credentials&lt;br/&gt;• Expired / invalid JWT&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="360" y="440" width="230" height="90" as="geometry" />
  </mxCell>

  <mxCell id="forbidEx" value="&lt;b&gt;ForbiddenException&lt;/b&gt;&lt;hr/&gt;HTTP 403 FORBIDDEN&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Unapproved employer&lt;br/&gt;• Insufficient role privilege&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="620" y="440" width="220" height="90" as="geometry" />
  </mxCell>

  <mxCell id="notFoundEx" value="&lt;b&gt;ResourceNotFoundException&lt;/b&gt;&lt;hr/&gt;HTTP 404 NOT_FOUND&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Job ID not found&lt;br/&gt;• User not found&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="870" y="440" width="240" height="90" as="geometry" />
  </mxCell>

  <mxCell id="conflictEx" value="&lt;b&gt;ConflictException&lt;/b&gt;&lt;hr/&gt;HTTP 409 CONFLICT&lt;br/&gt;&lt;i style=&quot;font-size: 11px; color: #64748b;&quot;&gt;• Duplicate email registration&lt;br/&gt;• Overbooking / capacity full&lt;br/&gt;• Duplicate booking&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#881337;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1140" y="440" width="250" height="100" as="geometry" />
  </mxCell>

  <!-- ApiExceptionHandler -->
  <mxCell id="handler" value="&lt;b&gt;&amp;lt;&amp;lt;RestControllerAdvice&amp;gt;&amp;gt;&lt;br/&gt;ApiExceptionHandler&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Exception Shielding &amp;amp; Encapsulation:&lt;/b&gt;&lt;br/&gt;+ handleApiException(ApiException, request) : ResponseEntity&amp;lt;ErrorResponse&amp;gt;&lt;br/&gt;+ handleValidationExceptions(...) : ResponseEntity&amp;lt;ErrorResponse&amp;gt;&lt;br/&gt;+ handleGeneralExceptions(...) : ResponseEntity&amp;lt;ErrorResponse&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#4c1d95;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="400" y="630" width="460" height="120" as="geometry" />
  </mxCell>

  <!-- ErrorResponse Record -->
  <mxCell id="errorRecord" value="&lt;b&gt;&amp;lt;&amp;lt;record, immutable&amp;gt;&amp;gt;&lt;br/&gt;ErrorResponse&lt;/b&gt;&lt;hr/&gt;+ Instant timestamp&lt;br/&gt;+ int status&lt;br/&gt;+ String error&lt;br/&gt;+ String message&lt;br/&gt;+ String path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#1e293b;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="940" y="630" width="230" height="120" as="geometry" />
