  </mxCell>

  <!-- OOP Notes Box -->
  <mxCell id="noteBox1" value="&lt;b&gt;Key OOP Insights Demonstrated Here:&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;Inheritance:&lt;/b&gt; BaseEntity defines shared audit fields (id, createdAt, updatedAt) and lifecycle hooks (@PrePersist). Extended by User, Job, Booking.&lt;br/&gt;• &lt;b&gt;Encapsulation:&lt;/b&gt; All entity fields are strictly private. State changes occur through rich domain methods (job.publish(), user.approve()).&lt;br/&gt;• &lt;b&gt;Composition over Inheritance:&lt;/b&gt; User roles (Student, Employer, Admin) are modeled via UserRole enum composition rather than relational table inheritance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1e3a8a;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="130" y="770" width="760" height="130" as="geometry" />
  </mxCell>

  <!-- Legend -->
  <mxCell id="legend1" value="&lt;b&gt;Diagram Legend / වර්ණ සටහන&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;color: #059669;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Green:&lt;/b&gt; Entities &amp;amp; Base Superclass (Inheritance)&lt;br/&gt;&lt;span style=&quot;color: #d97706;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Yellow:&lt;/b&gt; Enumerations (Type-Safe State &amp;amp; Role)&lt;br/&gt;&lt;span style=&quot;color: #059669;&quot;&gt;▬&lt;/span&gt; &lt;b&gt;Closed Arrow:&lt;/b&gt; Class Inheritance (extends)&lt;br/&gt;&lt;span style=&quot;color: #334155;&quot;&gt;→&lt;/span&gt; &lt;b&gt;Directed Arrow:&lt;/b&gt; Domain Association (1-to-Many)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#334155;shadow=1;" vertex="1" parent="1">
    <mxGeometry x="1000" y="770" width="350" height="130" as="geometry" />
  </mxCell>
</root>
